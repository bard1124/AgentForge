# Copy to ~/.agentforge/.env (or set AGENTFORGE_ENV_FILE). Values already in the
# environment take precedence. The worked-on project's own .env is never read.

# Cursor credentials; leave unset to use the key stored by `agentforge login`.
# CURSOR_API_KEY=cursor_...
# Alternative Cursor backend (rarely needed; the API key must be minted against it).
# CURSOR_BACKEND_URL=https://api2.cursor.sh

# Executor for a fresh board; auto-dispatch, executor, model, effort, and permission
# are set on the board (/forge-board) or with `agentforge config set`.
# AGENTFORGE_WORKER=cursor

# Worker model and parameters (see `agentforge models`).
AGENTFORGE_MODEL=composer-2.5
# AGENTFORGE_MODEL_PARAMS=reasoning=high

# Budgets per task.
AGENTFORGE_MAX_TURNS=20
AGENTFORGE_MAX_TASK_MINUTES=60
AGENTFORGE_MAX_REWORK=3
AGENTFORGE_VERIFY_TIMEOUT_SEC=900
AGENTFORGE_STALL_WARN_SEC=120
# Give up on starting the worker (agent creation or prompt send) after this long.
AGENTFORGE_START_TIMEOUT_SEC=300

# Cursor settings layers the worker loads: project,user,team,mdm,plugins,all
AGENTFORGE_SETTING_SOURCES=project
# AGENTFORGE_AUTO_REVIEW=1

# Extra tools and workers.
# MCP servers workers may use (default ~/.agentforge/mcp.json; ~ is not expanded here).
# AGENTFORGE_MCP_CONFIG=/abs/path/to/mcp.json
# AGENTFORGE_WORKERS=/abs/path/to/my-worker.mjs
